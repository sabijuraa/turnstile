{
  "name": "@turnstile/facilitator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "replay": "node dist/replay-main.js",
    "reclaim": "node dist/reclaim-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@turnstile/shared": "workspace:*",
    "bs58": "6.0.0",
    "hono": "4.13.11",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
