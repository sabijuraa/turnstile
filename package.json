{
  "name": "turnstile",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "check:stubs": "node infra/ci/check-stubs.mjs",
    "stack:up": "bash infra/scripts/stack.sh up",
    "stack:down": "bash infra/scripts/stack.sh down",
    "dev:up": "bash infra/scripts/dev-up.sh",
    "e2e": "bash infra/scripts/e2e.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
